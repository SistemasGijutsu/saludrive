RewriteEngine On
RewriteBase /saludgo/

# Permitir acceso al router
RewriteCond %{REQUEST_URI} ^/saludgo/routes/router\.php
RewriteRule ^ - [L]

# Evitar acceso directo a carpetas del sistema (excepto router.php)
RewriteCond %{REQUEST_URI} ^/saludgo/(app|config)/
RewriteRule ^(.*)$ - [F,L]

# Redirigir todo el tráfico restante a public/
RewriteCond %{REQUEST_URI} !^/saludgo/public/
RewriteCond %{REQUEST_URI} !^/saludgo/routes/router\.php
RewriteRule ^(.*)$ public/$1 [L]
